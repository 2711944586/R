# =============================================================================
# .gitignore  ·  Global Health Spending 项目
# 设计原则：
#   - 源代码、原始数据、外部数据缓存（gho/imf）、tracked 部署 bundle 全部入仓
#   - 大型派生缓存（master_enriched.rds、wdi_panel.rds 等）不入仓，由 构建.R 重建
#   - 网站静态产物（widgets/_files、shinylive 仪表盘）不入仓，由 CI 或本地构建生成
#   - secret 与本地 IDE 状态绝不入仓
# =============================================================================

# ---- R session / IDE -------------------------------------------------------
.Rhistory
.Rapp.history
.RData
.RDataTmp
.Ruserdata
*.Rproj
*.Rproj.user/
.Rproj.user
.vscode/
!.vscode/extensions.json

# ---- Build outputs ---------------------------------------------------------
*_cache/
*.knit.md
*.utf8.md

# 默认忽略 widget 依赖的 *_files/，但保留构建出来的对外资源目录
*_files/
!分析输出/交互组件/**/*_files/
!分析输出/交互组件/**/*_files/**
!网站发布/**/*_files/
!网站发布/**/*_files/**
!庄颂_20241334/**/*_files/
!庄颂_20241334/**/*_files/**

# ---- targets pipeline ------------------------------------------------------
_targets/
_targets_r/

# ---- renv（保留 activate.R / .lock，忽略本地 library） --------------------
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/staging/
renv/python/
renv/sandbox/

# ---- 派生数据缓存 ---------------------------------------------------------
# 原始缓存：WDI/世界地图/收入组等外部数据缓存，体积可观且可由 构建.R data 重建
派生数据/原始缓存/*.rds
派生数据/原始缓存/*.parquet
!派生数据/原始缓存/.gitkeep
# 处理结果：master_enriched 等核心派生表，由 构建.R features 重建
派生数据/处理结果/*
!派生数据/处理结果/.gitkeep
# 外部数据：gho/imf 缓存有意入仓以保证离线复现，不忽略

# ---- 分析产物 -------------------------------------------------------------
# 质量门禁报告由 构建.R quality 生成
分析输出/质量报告/

# ---- Shiny 部署中间产物 ---------------------------------------------------
# rsconnect 元数据含账号；snapshot 与程序库副本由 构建.R shinylive 重建
rsconnect/
仪表盘/数据快照/snapshot.rds
仪表盘/程序库/

# ---- 网站发布中间产物 -----------------------------------------------------
# 仅入仓核心入口与跨用户共享的 widget 副本；shinylive 与 _files 资源每次重建
网站发布/site_libs/
网站发布/search.json
网站发布/sitemap.xml

# ---- 最终交付包（默认每次重新生成） --------------------------------------
庄颂_20241334.zip
庄颂_20241334/

# ---- 操作系统副产物 -------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---- 日志 / 临时 ----------------------------------------------------------
*.log
logs/
.playwright-cli/
.playwright-mcp/
output/
派生数据/临时/
figs_index.txt
quarto-render.log
shiny.log
shiny.err
fig_log*.txt
_diag.qmd
_diag.html
_diag_files/

# ---- 打包 / 课程原题副本 --------------------------------------------------
*.zip
!网站发布/**/*.zip
/2026作业_*.docx

# ---- 课程提交中间产物 -----------------------------------------------------
课程提交/*完整静态展示.html

# ---- Secrets --------------------------------------------------------------
.env
.Renviron
.Rprofile.local

# 超过 100MB 的生成文件（离线分享用）
课程提交/庄颂_20241334.html
课程提交/庄颂_20241334.Rmd
网站发布/index.html
